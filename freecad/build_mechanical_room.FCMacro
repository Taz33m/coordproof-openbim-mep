SOURCE_PATH = os.path.join(ROOT, "freecad", "mechanical_room.FCStd")
BIM_PATH = os.path.join(ROOT, "freecad", "mechanical_room_bim.FCStd")
ASSEMBLY_STEP_PATH = os.path.join(ROOT, "exports", "step", "mechanical_room_assembly.step")

